# Production Dockerfile for knowledge-opc-ui
# Artifact / Output: /usr/share/nginx/html (Vite Static Bundle), Container Image: <registry>/knowledge-opc-ui:<version>

# ---------------------------------------------------------------------------
# Stage 1: Build static bundle
# ---------------------------------------------------------------------------
FROM node:24-bookworm-slim AS builder

WORKDIR /frontend

ARG NPM_REGISTRY=https://registry.npmmirror.com
ARG NODE_MAX_OLD_SPACE_SIZE=4096

ENV VITE_IS_DOCKER=true
ENV NODE_OPTIONS="--max-old-space-size=${NODE_MAX_OLD_SPACE_SIZE}"

COPY package.json package-lock.json ./
RUN if [ -n "$NPM_REGISTRY" ]; then \
      npm ci --registry="$NPM_REGISTRY"; \
    else \
      npm ci; \
    fi

COPY . .

ARG VITE_FRONTEND_COMMIT=unknown
ENV VITE_FRONTEND_COMMIT=${VITE_FRONTEND_COMMIT}
RUN npm run build

# ---------------------------------------------------------------------------
# Stage 2: Nginx runtime
# ---------------------------------------------------------------------------
FROM nginx:alpine

COPY --from=builder /frontend/dist /usr/share/nginx/html

COPY nginx.conf /etc/nginx/templates/default.conf.template
COPY nginx-api-proxy.conf /etc/nginx/api-proxy.conf
COPY nginx-http.conf /etc/nginx/conf.d/00-weknora-http.conf

COPY docker-entrypoint.sh /docker-entrypoint.sh
RUN chmod +x /docker-entrypoint.sh

ENV MAX_FILE_SIZE_MB=50
ENV APP_HOST=knowledge-opc-app
ENV APP_PORT=8080
ENV APP_SCHEME=http

EXPOSE 80

ENTRYPOINT ["/docker-entrypoint.sh"]
